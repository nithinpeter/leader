rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Leader is an internal tool: anyone signed in can read and write the
    // whole database. Sign-in is Google with no allowlist, so this is any
    // Google account that reaches the app - narrow the condition to an email
    // allowlist if the project ever holds anything that is not shared.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
