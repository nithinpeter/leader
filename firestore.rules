rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Leader is an internal tool: any signed-in teammate can work the
    // shared pipeline. Tighten to an email allowlist if the Firebase
    // project ever hosts anything else.
    match /leads/{leadId} {
      allow read, write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
