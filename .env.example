# Firebase web app config (Project settings -> General -> Your apps -> Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-side only. Used to generate propositions and opportunity docs
# via the Vercel AI SDK + Gemini. Get a key at https://aistudio.google.com/apikey
# Without it the app still works, using a plain template draft instead.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: override the Gemini model (defaults to gemini-3-pro-preview)
GEMINI_MODEL=

# Outreach email via Spacemail SMTP (server-side only).
# Username is the full mailbox address; password is that mailbox's password.
SMTP_USER=hello@westringia.com
SMTP_PASS=
# Defaults below suit Spacemail; only change if Spaceship's docs say so.
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_FROM_NAME=Westringia Labs

# Reading replies uses the same mailbox and credentials as sending.
IMAP_HOST=mail.spacemail.com
IMAP_PORT=993

# Outreach automation (the Cloud Function). Sending stays off until this is
# exactly "true", so a deploy cannot start emailing before you are ready.
AUTOMATION_ENABLED=false
# Shared secret the Cloud Scheduler job sends as x-cron-secret.
CRON_SECRET=

# The public contact-page function (leader-westringia) reads the automation
# vars above plus this: the daily ceiling on fresh research runs from
# westringia.com/contact across all visitors. Over the cap the page's website
# reader answers 503 and falls back to plain email + phone.
CONTACT_DAILY_RESEARCH_CAP=300

# Bulk import (server-side only). URL of the deployed leader-bulk-import
# function; it fans a pasted batch out to one importLead invocation per
# company. Leave empty and the import page runs the batch in the browser
# instead. Authenticated with the same CRON_SECRET as above.
BULK_IMPORT_URL=
