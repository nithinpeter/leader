# Firebase web app config (Project settings -> General -> Your apps -> Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-side only. Used to generate propositions and opportunity docs
# via the Vercel AI SDK + Gemini. Get a key at https://aistudio.google.com/apikey
# Without it the app still works, using a plain template draft instead.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: override the Gemini model (defaults to gemini-3-pro-preview)
GEMINI_MODEL=

# Outreach email via Spacemail SMTP (server-side only).
# Username is the full mailbox address; password is that mailbox's password.
SMTP_USER=hello@westringia.com
SMTP_PASS=
# Defaults below suit Spacemail; only change if Spaceship's docs say so.
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_FROM_NAME=Westringia Labs
